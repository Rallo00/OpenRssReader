<Window x:Class="OpenRssReader.FolderEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder" Width="420" Height="300" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource ContentBackgroundBrush}">
    <Window.Resources><Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource InputTextBrush}" /></Style></Window.Resources>
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock Text="Folder name" Margin="0,0,0,7" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" /><Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14" Height="42"><TextBox x:Name="FolderNameTextBox" BorderThickness="0" Background="Transparent" Padding="16,10" FontSize="15" VerticalContentAlignment="Center" /></Border><TextBlock x:Name="StatusText" Margin="0,8,0,0" Foreground="{DynamicResource ErrorTextBrush}" /></StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="Cancel" Click="CancelButton_Click" Width="92" Height="38" Margin="0,0,8,0" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="Transparent" /><Button Content="Save folder" Click="SaveButton_Click" Width="110" Height="38" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="Transparent" FontWeight="SemiBold" /></StackPanel>
    </Grid>
</Window>
