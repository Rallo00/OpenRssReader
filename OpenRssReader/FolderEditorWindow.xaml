<Window x:Class="OpenRssReader.FolderEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Width="540" Height="175" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="5,5,5,5" xmlns:loc="clr-namespace:OpenRssReader.Localization">
        <StackPanel Orientation="Vertical" Margin="5,5,5,5">
            <TextBlock x:Name="TitleText" Text="{loc:Loc FolderEditor.Title}" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{loc:Loc FolderEditor.Name}" Margin="0,20,0,0" />
            <TextBox x:Name="FolderNameTextBox" Margin="0,5,0,0" />
            <Button Content="{loc:Loc Common.Confirm}" Click="SaveButton_Click" Margin="0,5,0,0" Width="520" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Window>
