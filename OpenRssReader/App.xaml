<Application x:Class="OpenRssReader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenRssReader"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="LightSidebarBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="LightContentBrush" Color="#F7F6F4" />
        <SolidColorBrush x:Key="LightSelectionBrush" Color="#DEDDDB" />
        <SolidColorBrush x:Key="LightHoverBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="LightPrimaryTextBrush" Color="#403B36" />
        <SolidColorBrush x:Key="LightSecondaryTextBrush" Color="#7E766E" />
        <SolidColorBrush x:Key="LightMutedTextBrush" Color="#9A9188" />
        <SolidColorBrush x:Key="LightIconBrush" Color="#706F6E" />
        <SolidColorBrush x:Key="LightSidebarTitleBrush" Color="#444443" />
        <SolidColorBrush x:Key="LightFeedNameBrush" Color="#444443" />
        <SolidColorBrush x:Key="LightInputBackgroundBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="LightSeparatorBrush" Color="#DBDAD8" />
        <SolidColorBrush x:Key="LightInputTextBrush" Color="#3D3834" />
        <SolidColorBrush x:Key="DarkSidebarBrush" Color="#3E3E3E" />
        <SolidColorBrush x:Key="DarkContentBrush" Color="#292929" />
        <SolidColorBrush x:Key="DarkTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkSecondaryTextBrush" Color="#BDBDBD" />
        <SolidColorBrush x:Key="DarkSidebarTitleBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkFeedNameBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkInputBackgroundBrush" Color="#3E3E3E" />
        <SolidColorBrush x:Key="DarkInputTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DarkHoverBrush" Color="#4A4A4A" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F7F6F4" />
        <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#E3E1E1" />
        <SolidColorBrush x:Key="SelectionBackgroundBrush" Color="#DEDDDB" />
        <SolidColorBrush x:Key="SeparatorBrush" Color="#DBDAD8" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#706F6E" />
        <SolidColorBrush x:Key="SidebarTitleBrush" Color="#444443" />
        <SolidColorBrush x:Key="FeedNameBrush" Color="#444443" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#403B36" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#7E766E" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9A9188" />
        <SolidColorBrush x:Key="IconBrush" Color="#706F6E" />
        <SolidColorBrush x:Key="InputTextBrush" Color="#3D3834" />
        <SolidColorBrush x:Key="PlaceholderTextBrush" Color="#938B82" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#9A5A43" />
        <SolidColorBrush x:Key="ThumbnailBrush" Color="#E8E0D5" />
        <SolidColorBrush x:Key="FeedlyActionBrush" Color="#3F6F8C" />
        <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" />
        </Style>
    </Application.Resources>
</Application>
