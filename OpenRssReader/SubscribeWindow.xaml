<Window x:Class="OpenRssReader.SubscribeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Subscribe to feed" Width="540" Height="350" ResizeMode="NoResize">
    <Grid Margin="5,5,5,5">
        <StackPanel Orientation="Vertical" Margin="5,5,5,5">
            <TextBlock Text="Subscribe to feed" Margin="0,0,0,5" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Name shown in RSS Feeds:" Margin="0,20,0,0" />
            <TextBox x:Name="FeedNameTextBox" Margin="0,5,0,0" />
            <TextBlock Text="Feed address:" Margin="0,5,0,0" />
            <TextBox x:Name="FeedAddressTextBox" Margin="0,5,0,0" />
            <TextBlock Text="Parent folder:" Margin="0,5,0,0" />
            <ComboBox x:Name="FolderComboBox" Height="28" Margin="0,5,0,0" />
            <Button Margin="0,10,0,0" Content="Subscribe" Click="SearchButton_Click" HorizontalAlignment="Center" Width="520" Height="40" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Window>