<Window x:Class="OpenRssReader.SubscribeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Subscribe to feed" Width="540" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{DynamicResource ContentBackgroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource InputTextBrush}" /></Style>
        <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox"><Setter Property="Height" Value="42" /><Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14"><ToggleButton Background="Transparent" BorderThickness="0" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"><Grid><ContentPresenter Margin="16,0,38,0" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" /><Path Data="M7 10l5 5 5-5" Stroke="{DynamicResource IconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" Margin="0,0,15,0" /></Grid></ToggleButton></Border><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer CanContentScroll="True"><ItemsPresenter /></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8" /><Setter Property="Foreground" Value="{DynamicResource InputTextBrush}" /><Setter Property="Background" Value="Transparent" /></Style>
    </Window.Resources>
    <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock Text="Subscribe to feed" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
        <TextBlock Grid.Row="1" Text="Name shown in RSS Feeds" Margin="0,20,0,7" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Grid Grid.Row="1" Margin="0,44,0,0"><Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14" Height="42"><TextBox x:Name="FeedNameTextBox" BorderThickness="0" Background="Transparent" Padding="16,10" FontSize="15" VerticalContentAlignment="Center" /></Border><TextBlock Text="Feed display name (optional)" Margin="16,0" VerticalAlignment="Center" Foreground="{DynamicResource PlaceholderTextBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FeedNameTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <TextBlock Grid.Row="2" Text="Feed address" Margin="0,18,0,7" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
        <Grid Grid.Row="2" Margin="0,42,0,0"><Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="14" Height="42"><TextBox x:Name="FeedAddressTextBox" BorderThickness="0" Background="Transparent" Padding="16,10" FontSize="15" VerticalContentAlignment="Center" /></Border><TextBlock Text="Insert RSS feed or website URL" Margin="16,0" VerticalAlignment="Center" Foreground="{DynamicResource PlaceholderTextBrush}" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=FeedAddressTextBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
        <TextBlock Grid.Row="3" Text="Parent folder" Margin="0,18,0,7" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" />
        <ComboBox x:Name="FolderComboBox" Grid.Row="3" Margin="0,42,0,0" Style="{StaticResource RoundedComboBoxStyle}" />
        <StackPanel Grid.Row="4" Margin="0,18,0,0"><TextBlock x:Name="StatusText" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" /><Button Content="Search" Click="SearchButton_Click" Width="100" Height="38" HorizontalAlignment="Right" Margin="0,8,0,0" Background="{DynamicResource SurfaceBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="Transparent" BorderThickness="0" FontWeight="SemiBold"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="14"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template></Button></StackPanel>
    </Grid>
</Window>
