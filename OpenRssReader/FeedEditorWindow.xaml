<Window x:Class="OpenRssReader.FeedEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="" Width="540" Height="350" ResizeMode="NoResize">
    <Grid Margin="5,5,5,5" xmlns:loc="clr-namespace:OpenRssReader.Localization">
        <StackPanel Orientation="Vertical" Margin="5,5,5,5">
            <TextBlock Text="{loc:Loc FeedEditor.Title}" Margin="0,0,0,5" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="{loc:Loc Subscribe.Name}" Margin="0,20,0,0" />
            <TextBox x:Name="FeedNameTextBox" Margin="0,5,0,0" />
            <TextBlock Text="{loc:Loc Subscribe.Address}" Margin="0,5,0,0" />
            <TextBox x:Name="FeedAddressTextBox" Margin="0,5,0,0" />
            <TextBlock Text="{loc:Loc Subscribe.ParentFolder}" Margin="0,5,0,0" />
            <ComboBox x:Name="FolderComboBox" Height="28" Margin="0,5,0,0" />
            <Button Margin="0,10,0,0" Content="{loc:Loc Common.Confirm}" Click="SaveButton_Click" HorizontalAlignment="Center" Width="520" Height="40" />
            <TextBlock x:Name="StatusText" Margin="0,5,0,0" />
        </StackPanel>
    </Grid>
</Window>
